  VALUES ?p { wd:Q11455072 wd:Q11456997 wd:Q11459799 wd:Q11461703 wd:Q11462068 wd:Q11463825 wd:Q11465961 wd:Q11467979 wd:Q11469277 wd:Q11469295 wd:Q11470265 wd:Q11470302 wd:Q11490492 wd:Q11521734 wd:Q11523135 wd:Q11584352 wd:Q15987743 wd:Q19578015 wd:Q19578017 wd:Q24956001 wd:Q101200021 wd:Q104538809 wd:Q105711494 wd:Q2936949 wd:Q3025614 wd:Q5209148 wd:Q5752381 wd:Q5752709 wd:Q5760445 wd:Q5770440 wd:Q5770599 wd:Q5770605 wd:Q5771472 wd:Q5771594 wd:Q5772256 wd:Q5872201 wd:Q5965720 wd:Q5971139 wd:Q6148257 wd:Q6318684 wd:Q6406441 wd:Q6418717 wd:Q6419127 wd:Q6419152 wd:Q6451952 wd:Q6535130 wd:Q6746572 wd:Q6760911 wd:Q6782438 wd:Q6782587 wd:Q6782803 wd:Q6809947 wd:Q6837866 wd:Q6845539 wd:Q6849875 wd:Q6850242 wd:Q6884821 wd:Q6935945 wd:Q6959305 wd:Q7046040 wd:Q7046077 wd:Q7415460 wd:Q7505055 wd:Q8054590 wd:Q8190488 wd:Q11480055 wd:Q11496213 wd:Q11511282 wd:Q11523421 wd:Q11537417 wd:Q11540630 wd:Q11557401 wd:Q11557673 wd:Q11560791 wd:Q11565266 wd:Q11596478 wd:Q11619920 wd:Q11633891 wd:Q112762438 wd:Q116937109 wd:Q119517846 wd:Q122945610 wd:Q2703841 wd:Q11473013 wd:Q11474180 wd:Q11474560 wd:Q11477897 wd:Q11477938 wd:Q11479325 wd:Q11479805 wd:Q11481212 wd:Q11481795 wd:Q11483432 wd:Q11486234 wd:Q11487189 wd:Q11490810 wd:Q11492511 wd:Q11496829 wd:Q11497200 wd:Q11503948 wd:Q11504913 wd:Q11511909 wd:Q11513109 wd:Q11518167 wd:Q11518463 wd:Q11518991 wd:Q11519148 wd:Q11520423 wd:Q11521006 wd:Q11522190 wd:Q11523346 wd:Q11523351 wd:Q11531120 wd:Q11531511 wd:Q11538094 wd:Q11540727 wd:Q11543870 wd:Q11546228 wd:Q11547652 wd:Q11548892 wd:Q11552080 wd:Q11557313 wd:Q11560271 wd:Q11562168 wd:Q11566182 wd:Q11566305 wd:Q11569668 wd:Q11572078 wd:Q11574165 wd:Q11575371 wd:Q11575813 wd:Q11577091 wd:Q11577140 wd:Q11577147 wd:Q11586348 wd:Q11586411 wd:Q11586414 wd:Q11586726 wd:Q11590947 wd:Q11596724 wd:Q11598527 wd:Q11603564 wd:Q11606322 wd:Q11609117 wd:Q11610383 wd:Q11613306 wd:Q11613309 wd:Q11615524 wd:Q11616040 wd:Q11617095 }
