SELECT ?p (SAMPLE(?pLabel_ja) AS ?labelJa) (SAMPLE(?pLabel_en) AS ?labelEn) (GROUP_CONCAT(DISTINCT ?alt_ja; separator="|") AS ?altJa) (SAMPLE(?sherdog) AS ?sherdogId) (SAMPLE(?tapology) AS ?tapologyId) (MIN(?birthYear) AS ?birth) WHERE {
  VALUES ?p { wd:Q7678183 wd:Q71984 wd:Q262690 wd:Q280763 wd:Q323675 wd:Q378715 wd:Q379021 wd:Q461065 wd:Q484409 wd:Q487335 wd:Q510989 wd:Q41152 wd:Q45207 wd:Q1336512 wd:Q1376088 wd:Q1705122 wd:Q1705780 wd:Q2069759 wd:Q2073061 wd:Q2080446 wd:Q2086223 wd:Q2090890 wd:Q2271450 wd:Q2295056 wd:Q926027 wd:Q959636 wd:Q1057477 wd:Q1151941 wd:Q1154771 wd:Q1171177 wd:Q1188451 wd:Q3098906 wd:Q4701184 wd:Q5154955 wd:Q6964771 wd:Q7426402 wd:Q11365361 wd:Q11369428 wd:Q11413376 wd:Q11432602 wd:Q11451382 wd:Q11513093 wd:Q11598836 wd:Q11646595 wd:Q19364594 wd:Q19666958 wd:Q3544655 wd:Q4700928 wd:Q6313766 wd:Q6405567 wd:Q6782807 wd:Q8050031 wd:Q8056079 wd:Q11264118 wd:Q11379931 wd:Q11418111 wd:Q11462300 wd:Q11466757 wd:Q11491102 wd:Q11513175 wd:Q11561682 wd:Q11566959 wd:Q11613575 wd:Q11622899 wd:Q27917440 wd:Q62018825 wd:Q130725813 wd:Q11642215 wd:Q11642369 wd:Q11645268 wd:Q11646330 wd:Q11648147 wd:Q11651468 wd:Q11651878 wd:Q11653831 wd:Q11653941 wd:Q11655789 wd:Q11657778 wd:Q11664622 wd:Q11667858 wd:Q11670000 wd:Q11670520 wd:Q11675053 wd:Q11676015 wd:Q11677027 wd:Q11678755 wd:Q11679146 wd:Q15395513 wd:Q15984578 wd:Q2370844 wd:Q2525256 wd:Q2605547 wd:Q3275696 wd:Q4120094 wd:Q4700906 wd:Q5558394 wd:Q5686120 wd:Q5752647 wd:Q6425967 wd:Q8054530 wd:Q11323927 wd:Q11338146 wd:Q11344676 wd:Q11347638 wd:Q11358881 wd:Q11360885 wd:Q11361787 wd:Q11363133 wd:Q11365314 wd:Q11365794 wd:Q11367087 wd:Q11367084 wd:Q11372955 wd:Q11380061 wd:Q11382234 wd:Q11382247 wd:Q11383484 wd:Q11383721 wd:Q11383872 wd:Q11384202 wd:Q11384975 wd:Q11388645 wd:Q11388963 wd:Q11391829 wd:Q11394503 wd:Q11395094 wd:Q11395119 wd:Q11399068 wd:Q11399528 wd:Q11400354 wd:Q11411276 wd:Q11413174 wd:Q11413769 wd:Q11413924 wd:Q11418012 wd:Q11418093 wd:Q11418595 wd:Q11423250 wd:Q11427829 wd:Q11429179 wd:Q11430443 wd:Q11430529 wd:Q11434112 wd:Q11438201 wd:Q11438240 wd:Q11441900 wd:Q11443331 wd:Q11446038 wd:Q11451329 wd:Q11453156 }
  OPTIONAL { ?p rdfs:label ?pLabel_ja . FILTER(LANG(?pLabel_ja)="ja") }
  OPTIONAL { ?p rdfs:label ?pLabel_en . FILTER(LANG(?pLabel_en)="en") }
  OPTIONAL { ?p skos:altLabel ?alt_ja . FILTER(LANG(?alt_ja)="ja") }
  OPTIONAL { ?p wdt:P2818 ?sherdog . }
  OPTIONAL { ?p wdt:P9728 ?tapology . }
  OPTIONAL { ?p wdt:P569 ?birthDate . BIND(YEAR(?birthDate) AS ?birthYear) }
}
GROUP BY ?p